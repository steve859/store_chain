# Root Docker Compose environment
# Copy to .env and replace placeholder values for your machine/environment.

NODE_ENV=development
PORT=3000

# Backend API database connection used by the api container.
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/store_chain

# Redis connection used by the api container.
REDIS_URL=redis://redis:6379

# Local Postgres service settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=store_chain

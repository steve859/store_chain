# Phase 3: Operations Excellence - Environment Configuration
# Copy this to .env for Phase 3 deployment

# =============================================================================
# DATABASE REPLICATION (PostgreSQL HA)
# =============================================================================
# Primary database (write operations)
DATABASE_URL="postgresql://user:password@primary-db:5432/store_chain?schema=public"

# Read replicas (for reporting and read-heavy operations)
DB_REPLICA_1_URL="postgresql://user:password@replica-db-1:5432/store_chain?schema=public"
DB_REPLICA_2_URL="postgresql://user:password@replica-db-2:5432/store_chain?schema=public"

# pgBouncer connection pooling
PGBOUNCER_URL="postgresql://user:password@pgbouncer:6432/store_chain?schema=public"
PGBOUNCER_MIN_POOL_SIZE=20
PGBOUNCER_MAX_POOL_SIZE=500

# Patroni (HA orchestration)
PATRONI_URL="http://patroni-leader:8008"
PATRONI_REPLICATION_LAG_THRESHOLD_MS=5000

# =============================================================================
# REDIS CLUSTER (High Availability)
# =============================================================================
# Redis cluster nodes (comma-separated)
REDIS_CLUSTER_NODE_1="redis-node-1:6379"
REDIS_CLUSTER_NODE_2="redis-node-2:6379"
REDIS_CLUSTER_NODE_3="redis-node-3:6379"
REDIS_CLUSTER_NODE_4="redis-node-4:6379"
REDIS_CLUSTER_NODE_5="redis-node-5:6379"
REDIS_CLUSTER_NODE_6="redis-node-6:6379"

# Or use managed service
REDIS_URL="redis-cluster://redis.example.com:6379"

# Redis authentication
REDIS_PASSWORD="your-secure-password"

# Redis configuration
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY=100
REDIS_DB=0

# =============================================================================
# LOAD BALANCER & API SCALING
# =============================================================================
# Load balancer endpoint
LOAD_BALANCER_URL="https://api-load-balancer.example.com"

# API instances (for metrics)
API_INSTANCE_COUNT=4
API_INSTANCE_MIN=4
API_INSTANCE_MAX=16
API_AUTO_SCALE_THRESHOLD_CPU=70
API_AUTO_SCALE_THRESHOLD_MEMORY=80

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# S3 backup bucket
BACKUP_S3_BUCKET="store-chain-backups"
BACKUP_S3_REGION="us-east-1"

# Backup schedule (cron format)
BACKUP_FULL_SCHEDULE="0 2 * * *"         # 2 AM UTC daily
BACKUP_INCREMENTAL_SCHEDULE="0 */6 * * *" # Every 6 hours
BACKUP_REDIS_SCHEDULE="0 * * * *"         # Every hour

# Backup retention
BACKUP_FULL_RETENTION_DAYS=30
BACKUP_INCREMENTAL_RETENTION_DAYS=30
BACKUP_WAL_RETENTION_DAYS=365

# Last successful backup (for health checks)
LAST_BACKUP_TIME="2026-05-02T14:00:00Z"

# =============================================================================
# DISTRIBUTED TRACING (OpenTelemetry + Jaeger)
# =============================================================================
# Jaeger collector endpoint
JAEGER_ENDPOINT="http://jaeger-collector:14268/api/traces"
JAEGER_AGENT_HOST="jaeger-agent"
JAEGER_AGENT_PORT=6831

# Service name for tracing
SERVICE_NAME="store-chain-api"

# Trace sampling rate (0.0 to 1.0)
# 0.1 = 10% sampling (recommended for production)
TRACE_SAMPLE_RATE=0.1

# Enable console tracing in development
TRACE_CONSOLE_EXPORTER=false

# =============================================================================
# LOGGING (Elasticsearch + Kibana)
# =============================================================================
# Elasticsearch cluster
ELASTICSEARCH_URL="https://elasticsearch:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="password"

# Kibana UI
KIBANA_URL="http://kibana:5601"

# Log retention (days)
LOG_HOT_RETENTION=1      # 0-24 hours
LOG_WARM_RETENTION=6     # 1-7 days
LOG_COLD_RETENTION=23    # 7-30 days

# Log level
LOG_LEVEL="info"

# =============================================================================
# MONITORING (Prometheus + Grafana)
# =============================================================================
# Prometheus server
PROMETHEUS_URL="http://prometheus:9090"
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=15

# Grafana dashboard
GRAFANA_URL="http://grafana:3000"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin-password"

# Alert manager
ALERTMANAGER_URL="http://alertmanager:9093"

# =============================================================================
# SECURITY (WAF, DDoS, Secrets Management)
# =============================================================================
# AWS WAF
WAF_ENABLED=true
WAF_WEB_ACL_ARN="arn:aws:wafv2:us-east-1:123456789:global/webacl/store-chain/..."

# DDoS Protection
SHIELD_ENABLED=true
SHIELD_ADVANCED=false # Set to true for enhanced DDoS protection

# HashiCorp Vault (Secrets Management)
VAULT_ADDR="https://vault.example.com:8200"
VAULT_TOKEN="hvs.xxxxxxxxxxxxx"
VAULT_NAMESPACE="store-chain"

# Secrets paths in Vault
VAULT_SECRET_DATABASE_PATH="secret/store-chain/database"
VAULT_SECRET_API_KEYS_PATH="secret/store-chain/api-keys"
VAULT_SECRET_JWT_PATH="secret/store-chain/jwt"

# Certificate management (Let's Encrypt)
CERTIFICATE_AUTO_RENEWAL=true
CERTIFICATE_RENEWAL_DAYS_BEFORE=30

# =============================================================================
# DATA WAREHOUSE & BI
# =============================================================================
# Data Warehouse (Snowflake / BigQuery / Redshift)
WAREHOUSE_TYPE="snowflake" # or "bigquery", "redshift"
WAREHOUSE_ACCOUNT="xy12345"
WAREHOUSE_USER="etl_user"
WAREHOUSE_PASSWORD="password"
WAREHOUSE_DATABASE="analytics"
WAREHOUSE_SCHEMA="public"

# ETL Pipeline
ETL_INCREMENTAL_SCHEDULE="0 */4 * * *"  # Every 4 hours
ETL_FULL_SCHEDULE="0 1 * * *"           # 1 AM UTC daily

# BI Tool (Tableau / Looker / Metabase)
BI_TOOL="tableau"
BI_URL="https://tableau.example.com"
BI_API_KEY="your-api-key"
BI_EMBED_SECRET="your-embed-secret"

# =============================================================================
# DATABASE OPTIMIZATION
# =============================================================================
# Query timeout (milliseconds)
QUERY_TIMEOUT_MS=30000

# Slow query log threshold (milliseconds)
SLOW_QUERY_THRESHOLD_MS=500

# Max connections
MAX_DB_CONNECTIONS=500

# Connection pool settings
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=100
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_VALIDATION_QUERY="SELECT 1"

# =============================================================================
# API PERFORMANCE TUNING
# =============================================================================
# Request timeout (milliseconds)
REQUEST_TIMEOUT_MS=30000

# Max request body size
MAX_REQUEST_SIZE="50mb"

# API rate limits
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100   # per window, per IP
RATE_LIMIT_AUTH_MAX_REQUESTS=5 # per window, per IP

# Response compression
COMPRESSION_THRESHOLD_BYTES=1024

# Pagination defaults
PAGINATION_DEFAULT_LIMIT=100
PAGINATION_MAX_LIMIT=1000

# =============================================================================
# CACHE STRATEGY
# =============================================================================
# Cache TTL (Time To Live) in seconds
CACHE_TTL_PRODUCTS=60
CACHE_TTL_STORES=300
CACHE_TTL_REPORTS=3600

# Cache invalidation
CACHE_INVALIDATE_ON_PRODUCT_UPDATE=true
CACHE_INVALIDATE_ON_PRICE_UPDATE=true

# =============================================================================
# INFRASTRUCTURE MONITORING
# =============================================================================
# Health check intervals
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_CHECK_REPLICATION_LAG_THRESHOLD_MS=5000
HEALTH_CHECK_BACKUP_AGE_THRESHOLD_MINUTES=360

# Failover settings
FAILOVER_ENABLED=true
FAILOVER_AUTO_PROMOTE=true
FAILOVER_TIMEOUT_MS=30000

# =============================================================================
# APPLICATION INFO
# =============================================================================
APP_VERSION="3.0.0"
NODE_ENV="production"
DEBUG=false

# =============================================================================
# NOTIFICATION & ALERTING
# =============================================================================
# Alert recipients
ALERT_EMAIL_RECIPIENTS="ops@example.com,devops@example.com"
ALERT_SLACK_WEBHOOK="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# PagerDuty integration (for on-call)
PAGERDUTY_API_KEY="xxx"
PAGERDUTY_SERVICE_ID="xxx"

# =============================================================================
# DEPLOYMENT INFO
# =============================================================================
DEPLOY_ENVIRONMENT="production"
DEPLOY_REGION="us-east-1"
DEPLOY_AVAILABILITY_ZONES="us-east-1a,us-east-1b,us-east-1c"

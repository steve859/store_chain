# Backend environment variables
# Copy to .env and replace placeholder values for your machine/environment.

NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-use-a-long-random-value

# Local Postgres connection for running the backend outside Docker.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/store_chain

# Optional shadow DB for Prisma migrations, if needed.
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/store_chain_shadow

# Optional read replicas for read-heavy endpoints (comma-separated)
# DATABASE_READ_REPLICA_URLS=postgres://postgres:postgres@localhost:5433/store_chain,postgres://postgres:postgres@localhost:5434/store_chain

# Neon (cloud Postgres) example (use Direct connection, usually requires TLS)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Redis cache/queue configuration.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional Redis Cluster nodes (comma-separated host:port)
# REDIS_CLUSTER_NODES=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379

# Browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: catalog cache TTL in seconds (clamped to 30–60)
CATALOG_CACHE_TTL_SECONDS=45

# Security and request limits.
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT_MS=30000

# Event Bus Configuration
EVENT_DRIVEN_ENABLED=true
EVENT_BUS_MAX_LISTENERS=100

# Real-time Inventory Sync (ASR-S2)
WEBSOCKET_BROADCAST_ENABLED=true
INVENTORY_SYNC_PRIORITY=10
INVENTORY_SYNC_CONCURRENCY=10

# Dynamic Pricing Engine (ASR-S3)
PRICING_BATCH_ENABLED=true
PRICING_RULE_CACHE_TTL=300
PRICING_RESPONSE_CACHE_TTL=120
PRICING_BATCH_SIZE=1000
PRICING_JOB_CONCURRENCY=5
PRICING_JOB_PRIORITY=5

# Dynamic Price Lookup Optimization (ASR-P1)
PRICING_ENGINE_TTL=900
PRICING_ENGINE_PRELOAD_BATCH_SIZE=100
PRICING_ENGINE_MEMORY_LIMIT_MB=200
PRICING_CACHE_L1_ENABLED=true

# ─────────────────────────────────────────────────
# ASR-M3: Observability (Tracing & Logging)
# ─────────────────────────────────────────────────
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=store-chain-api

ELK_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELK_INDEX=store-chain-logs

# ─────────────────────────────────────────────────
# ASR-SEC5: PII Encryption
# ─────────────────────────────────────────────────
# PII_ENCRYPTION_KEY=12345678901234567890123456789012

# Backend environment variables
# Copy to .env and adjust values

PORT=3000
JWT_SECRET=your-secret-key-change-it

# Local Postgres (matches docker-compose defaults when using localhost port 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store_chain

# Optional read replicas for read-heavy endpoints (comma-separated)
# DATABASE_READ_REPLICA_URLS=postgres://postgres:postgres@localhost:5433/store_chain,postgres://postgres:postgres@localhost:5434/store_chain

# Neon (cloud Postgres) example (use Direct connection, usually requires TLS)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional Redis (used for lightweight caching)
REDIS_URL=redis://localhost:6379

# Optional Redis Cluster nodes (comma-separated host:port)
# REDIS_CLUSTER_NODES=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379

# Optional: catalog cache TTL in seconds (clamped to 30–60)
CATALOG_CACHE_TTL_SECONDS=45

# Event Bus Configuration
# Enable event-driven inventory sync (default: true)
EVENT_DRIVEN_ENABLED=true
# Event bus max listeners (default: 100)
EVENT_BUS_MAX_LISTENERS=100

# Real-time Inventory Sync (ASR-S2)
# WebSocket broadcasting of inventory updates (default: true)
WEBSOCKET_BROADCAST_ENABLED=true
# Inventory sync job priority (1-10, higher = more important, default: 10)
INVENTORY_SYNC_PRIORITY=10
# Concurrent inventory sync jobs (default: 10)
INVENTORY_SYNC_CONCURRENCY=10

# Dynamic Pricing Engine (ASR-S3)
# Enable batch pricing recalculation every 15 minutes (default: true)
PRICING_BATCH_ENABLED=true
# Pricing rule cache TTL in seconds (default: 300 = 5 minutes)
PRICING_RULE_CACHE_TTL=300
# Pricing response cache TTL in seconds (default: 120 = 2 minutes)
PRICING_RESPONSE_CACHE_TTL=120
# Batch size for pricing recalculation (variants per job, default: 1000)
PRICING_BATCH_SIZE=1000
# Job queue concurrency for pricing jobs (default: 5)
PRICING_JOB_CONCURRENCY=5
# Job priority for pricing (1-10, higher = more important, default: 5)
PRICING_JOB_PRIORITY=5

# Dynamic Price Lookup Optimization (ASR-P1)
# In-memory pricing engine TTL in seconds (matches batch cadence, default: 900 = 15 minutes)
PRICING_ENGINE_TTL=900
# Variant preload batch size (variants per preload job, default: 100)
PRICING_ENGINE_PRELOAD_BATCH_SIZE=100
# In-memory engine memory limit in MB (default: 200)
PRICING_ENGINE_MEMORY_LIMIT_MB=200
# Enable L1 in-memory cache (default: true)
PRICING_CACHE_L1_ENABLED=true

# ─────────────────────────────────────────────────
# ASR-M3: Observability (Tracing & Logging)
# ─────────────────────────────────────────────────

# OpenTelemetry Distributed Tracing
# Set to 'false' to disable tracing entirely
TRACING_ENABLED=true
# OTLP HTTP exporter endpoint (Jaeger OTLP port)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Service name shown in Jaeger UI
OTEL_SERVICE_NAME=store-chain-api

# ELK Centralized Logging
# Set to 'true' to stream logs to Elasticsearch
ELK_ENABLED=false
# Elasticsearch URL
ELASTICSEARCH_URL=http://localhost:9200
# Index prefix for logs
ELK_INDEX=store-chain-logs

# ─────────────────────────────────────────────────
# ASR-SEC5: PII Encryption
# ─────────────────────────────────────────────────
# 32-byte key for AES-256-CBC encryption of PII fields
# PII_ENCRYPTION_KEY=12345678901234567890123456789012

